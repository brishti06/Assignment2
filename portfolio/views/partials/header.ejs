<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %></title>

    <link rel="stylesheet" href="/stylesheets/style.css">
    <!-- Font Awesome CSS -->
    <link rel="stylesheet" href="/font-awesome/css/font-awesome.min.css">
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="/bootstrap/dist/css/bootstrap.min.css">
   </head>
 
   <body>
<nav class="navbar navbar-expand-lg navbar-light bg-light">
  <div class="container-fluid">
    <a class="navbar-brand" href="/">Brishti Chauhan</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ms-auto">
        <li class="nav-item">
          <a class="nav-link <%= title === 'Home' ? 'active' : '' %>" href="/">
            <i class="fa-solid fa-house"></i> Home</a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= title === 'About Me' ? 'active' : '' %>" href="/about">
            <i class="fa-solid fa-user"></i> About</a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= title === 'Projects' ? 'active' : '' %>" href="/projects">
            <i class="fa-solid fa-folder-open"></i> Projects</a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= title === 'Contact' ? 'active' : '' %>" href="/contact">
            <i class="fa-solid fa-envelope"></i> Contact</a>
        </li>
      </ul>
    </div>
  </div>
</nav>
